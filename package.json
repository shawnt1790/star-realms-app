{
  "name": "starrealms-io",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm -w @sr/shared run build && npm -w @sr/server run build && npm -w @sr/client run build",
    "build:heroku": "npm run build",
    "heroku-postbuild": "npm run build:heroku",
    "start": "npm -w @sr/server run start",
    "test": "npm -ws run test --if-present",
    "lint": "eslint . && npm -w @sr/client run lint",
    "typecheck": "npm -w @sr/shared run build && npm -w @sr/server run typecheck && npm -w @sr/client run typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
